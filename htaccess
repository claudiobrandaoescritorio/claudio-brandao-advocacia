# Apache (Hostinger, cPanel, etc.)

# --- HTTPS e domínio canônico (sem www) ---
RewriteEngine On
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://claudiobrandao.adv.br%{REQUEST_URI} [L,R=301]

# --- Cabeçalhos de segurança ---
# A CSP é definida SOMENTE aqui (e no _headers, se hospedar em Netlify/Cloudflare).
# Ela não está mais no <meta> do index.html. Se alterar qualquer <script> inline,
# recalcule o hash sha256 e atualize a linha abaixo.
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://www.googletagmanager.com 'sha256-wgblRTFGa3pLApXI+1LxbXyLNJXpyjtCiGQm0fWbqnE=' 'sha256-AzYboIi3c/kfBwHawFR4hczfGMDjKh7P5KQHYHGN6iU=' 'unsafe-hashes' 'sha256-MhtPZXr7+LpJUY5qtMutB+qWfQtMaPccfe7QXtCcEYc='; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data: https://*.google-analytics.com https://*.googletagmanager.com; frame-src https://maps.google.com https://www.google.com; connect-src https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests"
</IfModule>

# --- Evitar exposição de informações ---
Options -Indexes
ServerSignature Off
<IfModule mod_headers.c>
  Header always unset X-Powered-By
</IfModule>

# Bloqueia arquivos ocultos e de backup (exceto /.well-known)
RedirectMatch 404 /\.(?!well-known)
<FilesMatch "\.(bak|old|orig|sql|log|env|ini|sh|md|zip|tar|gz)$">
  Require all denied
</FilesMatch>

# --- Compressão (Brotli quando disponível, senão gzip/deflate) ---
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/xml application/xml application/javascript text/javascript application/json application/ld+json image/svg+xml
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/xml application/javascript text/javascript application/json application/ld+json image/svg+xml
</IfModule>

# --- Cache ---
# HTML/XML/TXT: o navegador sempre revalida (mudanças aparecem na hora)
# JS/CSS: 1 dia (arquivos sem versão no nome, como analytics.js, atualizam em até 24h)
# Imagens e fontes: 30 dias
<IfModule mod_headers.c>
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
  <FilesMatch "\.(png|jpe?g|webp|avif|gif|svg|ico|woff2?)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>
