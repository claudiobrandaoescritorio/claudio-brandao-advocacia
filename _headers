# Cabeçalhos de segurança para Netlify / Cloudflare Pages.
# Em Apache/Hostinger/cPanel, use o .htaccess; em Nginx, veja o nginx.conf.
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' https://www.googletagmanager.com 'sha256-wgblRTFGa3pLApXI+1LxbXyLNJXpyjtCiGQm0fWbqnE=' 'sha256-AzYboIi3c/kfBwHawFR4hczfGMDjKh7P5KQHYHGN6iU=' 'unsafe-hashes' 'sha256-MhtPZXr7+LpJUY5qtMutB+qWfQtMaPccfe7QXtCcEYc='; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data: https://*.google-analytics.com https://*.googletagmanager.com; frame-src https://maps.google.com https://www.google.com; connect-src https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests

/assets/*
  Cache-Control: public, max-age=86400

/assets/*.png
  Cache-Control: public, max-age=2592000

/assets/*.jpg
  Cache-Control: public, max-age=2592000

/assets/*.webp
  Cache-Control: public, max-age=2592000

/*.html
  Cache-Control: public, max-age=0, must-revalidate
